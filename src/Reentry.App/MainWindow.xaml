<Window
    x:Class="Reentry.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:vm="using:Reentry.App.ViewModels"
    Title="Reentry">

    <Grid Padding="16" RowSpacing="8">
        <Grid.Resources>
            <Style x:Key="HudRowItem" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
            <Style TargetType="primitives:ScrollBar">
                <Setter Property="IndicatorMode" Value="MouseIndicator"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Reentry" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Bind ViewModel.BootBanner, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Bind ViewModel.BootDetail, Mode=OneWay}" Opacity="0.75" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Minimum="0" Maximum="1"
                         Value="{x:Bind ViewModel.SettledFraction, Mode=OneWay}"
                         Height="4"
                         VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.SettledSummary, Mode=OneWay}"
                       FontSize="12"
                       Opacity="0.8"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,4,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Session restore (inferred)" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.RestoreTiming, Mode=OneWay}"
                       FontSize="11"
                       Opacity="0.75"
                       VerticalAlignment="Center"/>
        </Grid>
        <ListView x:Name="RestoreList"
                  Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.RestoreRows, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource HudRowItem}"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Loaded="HudList_Loaded">
            <ListView.ItemContainerTransitions>
                <TransitionCollection/>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackedAppRow">
                    <Grid ColumnSpacing="8" MinHeight="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Background="#332DB4A0"
                                Padding="5,1"
                                CornerRadius="3"
                                Visibility="{x:Bind ManagedVisibility, Mode=OneWay}"
                                VerticalAlignment="Center">
                            <TextBlock Text="managed" FontSize="10" Opacity="0.9"/>
                        </Border>
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind Source, Mode=OneWay}"
                                   Opacity="0.6"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3"
                                   Text="{x:Bind TimingText, Mode=OneWay}"
                                   Opacity="0.7"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="4"
                                Background="{x:Bind StateBrush, Mode=OneWay}"
                                Padding="6,1"
                                CornerRadius="3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind State, Mode=OneWay}"
                                       Foreground="{x:Bind ChipForeground, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="4" Margin="0,4,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Startup apps" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.StartupTiming, Mode=OneWay}"
                       FontSize="11"
                       Opacity="0.75"
                       VerticalAlignment="Center"/>
        </Grid>
        <ListView x:Name="StartupList"
                  Grid.Row="5"
                  ItemsSource="{x:Bind ViewModel.StartupRows, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource HudRowItem}"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Loaded="HudList_Loaded">
            <ListView.ItemContainerTransitions>
                <TransitionCollection/>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackedAppRow">
                    <Grid ColumnSpacing="8" MinHeight="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Background="#332DB4A0"
                                Padding="5,1"
                                CornerRadius="3"
                                Visibility="{x:Bind ManagedVisibility, Mode=OneWay}"
                                VerticalAlignment="Center">
                            <TextBlock Text="managed" FontSize="10" Opacity="0.9"/>
                        </Border>
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind Source, Mode=OneWay}"
                                   Opacity="0.6"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3"
                                   Text="{x:Bind TimingText, Mode=OneWay}"
                                   Opacity="0.7"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="4"
                                Background="{x:Bind StateBrush, Mode=OneWay}"
                                Padding="6,1"
                                CornerRadius="3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind State, Mode=OneWay}"
                                       Foreground="{x:Bind ChipForeground, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="6">
            <TextBlock Text="Session elapsed" Opacity="0.7" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.FooterElapsed, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>

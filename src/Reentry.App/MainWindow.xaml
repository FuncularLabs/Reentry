<Window
    x:Class="Reentry.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Reentry.App.ViewModels"
    Title="Reentry">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Reentry" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Bind ViewModel.BootBanner, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Bind ViewModel.BootDetail, Mode=OneWay}" Opacity="0.75" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Session restore (inferred)" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.RestoreRows, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackedAppRow">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind StateGlyph, Mode=OneWay}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"/>
                            <TextBlock Text="Reentry-managed" Opacity="0.7" FontSize="11" Visibility="{x:Bind ManagedVisibility, Mode=OneWay}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind Source, Mode=OneWay}" Opacity="0.7" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind State, Mode=OneWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind Elapsed, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="3" Text="Startup apps" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <ListView Grid.Row="4" ItemsSource="{x:Bind ViewModel.StartupRows, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackedAppRow">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind StateGlyph, Mode=OneWay}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"/>
                            <Border Background="#223D8B40" Padding="6,1" CornerRadius="4"
                                    Visibility="{x:Bind ManagedVisibility, Mode=OneWay}" HorizontalAlignment="Left">
                                <TextBlock Text="Reentry-managed" FontSize="11"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind Source, Mode=OneWay}" Opacity="0.7" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind State, Mode=OneWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind Elapsed, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="5">
            <TextBlock Text="Session elapsed" Opacity="0.7" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.FooterElapsed, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>

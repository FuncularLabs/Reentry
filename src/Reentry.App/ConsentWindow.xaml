<Window
    x:Class="Reentry.App.ConsentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Reentry">

    <StackPanel Padding="24" Spacing="16" MaxWidth="480">
        <TextBlock Text="Start with Windows?" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap"
                   Text="Start with Windows so we can show restore progress after a reboot. Reentry registers a per-user logon task (no highest privileges) and a HKCU Run value. You can turn this off later in Settings."/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Not now" Click="Decline_Click"/>
            <Button Content="Start with Windows" Style="{StaticResource AccentButtonStyle}" Click="Accept_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window
    x:Class="Reentry.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Reentry.App.ViewModels"
    Title="Reentry settings">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="16" MaxWidth="720">
            <TextBlock Text="Reentry" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Manage user-facing startup apps. Disabling writes StartupApproved and leaves the Run value in place." TextWrapping="Wrap" Opacity="0.8"/>

            <ToggleSwitch Header="Start with Windows" IsOn="{x:Bind ViewModel.AutostartEnabled, Mode=TwoWay}"/>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <NumberBox Header="Hung after (seconds)" Value="{x:Bind ViewModel.HungNoWindowSeconds, Mode=TwoWay}" Minimum="15" Maximum="600"/>
                <NumberBox Header="Failed-exit window (seconds)" Value="{x:Bind ViewModel.FailedExitSeconds, Mode=TwoWay}" Minimum="5" Maximum="120"/>
            </StackPanel>

            <Button Content="Save settings" Command="{x:Bind ViewModel.SaveAutostartCommand}"/>

            <TextBlock Text="Startup inventory" FontWeight="SemiBold"/>
            <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:InventoryRow">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Item.Name}"/>
                                <TextBlock Text="{x:Bind Badge}" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Source}" VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind Scope}" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="{x:Bind EnabledLabel, Mode=OneWay}"
                                    Click="Toggle_Click" Tag="{x:Bind}"/>
                            <Button Grid.Column="4" Content="Remove"
                                    Visibility="{x:Bind ManagedVisibility}"
                                    Click="Remove_Click" Tag="{x:Bind}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="Add a Reentry-owned user Run entry" FontWeight="SemiBold"/>
            <TextBox Header="Name" Text="{x:Bind ViewModel.NewName, Mode=TwoWay}"/>
            <TextBox Header="Command" Text="{x:Bind ViewModel.NewCommand, Mode=TwoWay}"/>
            <Button Content="Add" Command="{x:Bind ViewModel.AddManagedCommand}"/>

            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.8"/>
        </StackPanel>
    </ScrollViewer>
</Window>
